# ==============================================================================
# MahaSetu: Gujarat State Alumni Association Platform — Environment Configuration
# ==============================================================================

# Node Environment ('development', 'test', 'production')
NODE_ENV=production

# Server Port
PORT=5001

# MongoDB Connection String (Mandatory in production. Refuses in-memory fallback in prod)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/mahasetu?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mahasetu

# JWT Secret & Expiration
# Generate a high-entropy secret using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_high_entropy_secret_at_least_64_characters_long
JWT_EXPIRES_IN=24h

# Razorpay Payment Gateway Credentials (Required for live Indian payment collection & 80G receipts)
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Event Ticket Cryptographic Signature Secret (Used for verifiable HMAC QR code tokens)
EVENT_SECRET=replace_with_secure_ticket_hmac_secret_key_2025

# OTP Cryptographic Salt
OTP_SALT=replace_with_secure_otp_salt_key_2025

# Email & SMS Gateway Configuration (For OTP dispatch & notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
EMAIL_FROM="MahaSetu Alumni Cell <alumni@gujarat.gov.in>"

# File Storage & Uploads
# Local disk storage path: uploads/
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Optional: Allow Seeding in Production (Defaults to false)
ALLOW_PROD_SEED=false

# Optional: Allow Dev OTP in Response (Strictly false in production)
ALLOW_DEV_OTP=false
