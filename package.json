{
  "name": "alumni-association-platform",
  "version": "1.0.0",
  "description": "Gujarat Education Department - Multi-College Alumni Platform in React, Node.js & MongoDB",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "electron": "concurrently -k -n \"server,client,electron\" -c \"cyan.bold,blue.bold,magenta.bold\" \"npm run server\" \"npm run client\" \"wait-on tcp:5173 tcp:5001 && electron .\"",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder --mac dmg",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuvanshj/NST-AD-ELECTRON-PROJECT.git"
  },
  "keywords": [
    "react",
    "javascript",
    "mongodb",
    "mongoose",
    "express",
    "alumni",
    "gujarat-education"
  ],
  "author": "Antigravity Pair",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.9.5",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.mahasetu.alumni",
    "productName": "MahaSetu",
    "copyright": "Copyright © 2026 Gujarat Education Department & GTU",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version} Installer",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
